// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  VOLUNTEER
  ORGANIZATION_ADMIN
  ADMIN
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum IncidentCategory {
  FIRE
  FLOOD
  ACCIDENT
  MEDICAL
  BUILDING_COLLAPSE
  MISSING_PERSON
  NATURAL_DISASTER
  OTHER
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  UNDER_REVIEW
  VERIFIED
  ASSIGNED
  RESPONDING
  RESOLVED
  REJECTED
  CANCELLED
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  phone        String?
  role         Role           @default(CITIZEN)
  isVerified   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  // Relations
  volunteer    Volunteer?
  refreshTokens RefreshToken[]
  incidents    Incident[]     @relation("ReportedIncidents")
}

model Volunteer {
  id                 String             @id @default(uuid())
  userId             String             @unique
  availabilityStatus AvailabilityStatus @default(OFFLINE)
  latitude           Float?
  longitude          Float?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             Skill[]            @relation("VolunteerSkills")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  
  // Relations
  volunteers Volunteer[] @relation("VolunteerSkills")
  incidents  Incident[]  @relation("IncidentSkills")
}

model Incident {
  id               String           @id @default(uuid())
  reportedById     String
  title            String
  description      String
  category         IncidentCategory
  priority         IncidentPriority @default(MEDIUM)
  status           IncidentStatus   @default(REPORTED)
  latitude         Float
  longitude        Float
  address          String?
  aiClassification String?
  aiConfidence     Float?
  peopleAtRisk     Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  resolvedAt       DateTime?

  // Relations
  reportedBy       User             @relation("ReportedIncidents", fields: [reportedById], references: [id])
  requiredSkills   Skill[]          @relation("IncidentSkills")

  @@index([reportedById])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

